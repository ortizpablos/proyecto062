<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            background-color: #dbc3e0b7;
        }

        header {
            background-color: #c5b7caa9;
            color: rgb(3, 3, 3);
            text-align: center;
            padding: 10px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 100px;
            padding: 100px;
        }

        .product {
            background: white;
            border: 1px solid #0c0c0c;
            border-radius: 5px;
            padding: 10px;
            text-align: center;
        }

        .product button {
            background-color: #eab5ec;
            color: white;
            border: none;
            padding: 0.5rem 1px;
            border-radius: 5px;
            cursor: pointer;
        }

        .product button:hover {
            background-color: #944bb1;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(236, 192, 250, 0.5);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: rgb(179, 143, 180);
            padding: 2px;
            border-radius: 5px;
            width: 1000%;
            max-width: 500px;
            text-align: center;
        }

        .cart-items {
            max-height: 2000px;
            overflow-y: auto;
            margin: 1px 0;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5px 0;
            border-bottom: 1px solid #050505;
        }

        .modal button {
            margin: 0.5px;
        }

        footer {
            text-align: center;
            padding: 1px;
            background-color: #c5b7caa9;
            color: rgb(0, 0, 0);
            position: fixed;
            bottom: 1px;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <h1>Carrito de Compras</h1>
    </header>

    <section class="products">
        <div class="product" data-name="Producto 1" data-price="50000">
            <h3>Producto 1</h3>
            <p>Ropa</p>
            <p>Precio: $70.000-50.000</p>
            <button class="add-to-cart">Descripcion</button>
        </div>
        <div class="product" data-name="Producto 2" data-price="30000">
            <h3>Producto 2</h3>
            <p>Juguetes</p>
            <p>Precio: $20.000-30.000</p>
            <button class="add-to-cart">Descripcion</button>
        </div>
        <div class="product" data-name="Producto 3" data-price="10000">
            <h3>Producto 3</h3>
            <p>Cacharreria</p>
            <p>Precio: $5.000-10.000</p>
            <button class="add-to-cart">Descripcion</button>
        </div>
    </section>

    <div class="modal" id="cart-modal">
        <div class="modal-content">
            <h2>Carrito</h2>
            <div class="cart-items" id="cart-items"></div>
            <p>Total: $<span id="total-price">000</span></p>
            <button id="clear-cart">Pagar</button>
            <button id="close-modal">Continuar con las Compras</button>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 Carrito de Compras</p>
    </footer>

    <script>
        const products = document.querySelectorAll('.add-to-cart');
        const cartModal = document.getElementById('cart-modal');
        const cartItemsContainer = document.getElementById('cart-items');
        const totalPriceElement = document.getElementById('total-price');
        const clearCartButton = document.getElementById('clear-cart');
        const closeModalButton = document.getElementById('close-modal');

        let cart = [];

        products.forEach(button => {
            button.addEventListener('click', () => {
                const product = button.closest('.product');
                const name = product.getAttribute('data-name');
                const price = parseFloat(product.getAttribute('data-price'));
                
                cart.push({ name, price });
                updateCart();
                cartModal.style.display = 'flex';
            });
        });

        const updateCart = () => {
            cartItemsContainer.innerHTML = '';
            let total = 0;

            cart.forEach((item, index) => {
                const cartItem = document.createElement('div');
                cartItem.className = 'cart-item';

                cartItem.innerHTML = `
                    <span>${item.name}</span>
                    <span>$${item.price}</span>
                    <button class="remove-item" data-index="${index}">Eliminar</button>
                `;
                cartItemsContainer.appendChild(cartItem);
                total += item.price;
            });

            totalPriceElement.textContent = total.toFixed(2);

            document.querySelectorAll('.remove-item').forEach(button => {
                button.addEventListener('click', () => {
                    const index = parseInt(button.getAttribute('data-index'));
                    cart.splice(index, 1);
                    updateCart();
                });
            });
        };

        clearCartButton.addEventListener('click', () => {
            cart = [];
            updateCart();
        });

        closeModalButton.addEventListener('click', () => {
            cartModal.style.display = 'none';
        });

        window.addEventListener('click', (e) => {
            if (e.target === cartModal) {
                cartModal.style.display = 'none';
            }
        });
    </script>
</body>
</html>
